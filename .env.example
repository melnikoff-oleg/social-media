# Copy this file to .env (same folder, this one right here at the project root)
# and paste your three keys after the "=" signs. No quotes, no spaces.
#
#   macOS / Linux:      cp .env.example .env
#   Windows PowerShell: Copy-Item .env.example .env
#
# The real .env is gitignored on purpose, which is why it is not in the download.
# That is normal: keys are yours, they never belong in a public repo.

# Scrapes competitors' Instagram videos.
# Sign up at https://apify.com (free plan includes $5 of usage a month),
# then Settings -> Integrations -> Personal API token.
APIFY_API_TOKEN=

# Watches the videos and writes the breakdown.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Generates the new video concepts.
# Get a key at https://platform.claude.com -> API keys.
# NOTE: this is the pay-per-token API, which needs prepaid credit on that
# account. It is a separate bill from a Claude Pro or Max subscription, and a
# subscription does not fund it. "Credit balance too low" means this account is
# at zero, not that anything is broken.
ANTHROPIC_API_KEY=

# Optional. Alternative concept generator, picked per run on the Run page ("Modelo de conceitos").
# Get a key at https://platform.deepseek.com -> API keys. Model blank = deepseek-chat.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Optional. Which Gemini model watches the videos.
# Leave blank to use the default (gemini-2.5-flash).
# Google retires models regularly, so if you ever get a 404 saying the model
# does not exist, list what your key can reach and put one of those here:
#   curl "https://generativelanguage.googleapis.com/v1/models?key=YOUR_KEY"
# gemini-3.1-flash-lite is cheaper per token if you are watching cost.
GEMINI_MODEL=

# Local Postgres (started with `docker compose up -d db`, see docker-compose.yml).
# These match the compose credentials; they are local-only, not real secrets.
# Host port is 5435 on purpose (5432 is used by another container on the owner's machine).
DATABASE_URL=postgres://app:app@localhost:5435/social_media
# Separate database used only by the test suite.
TEST_DATABASE_URL=postgres://app:app@localhost:5435/social_media_test

# Not used in v1, leave empty.
# SESSION_SECRET=
